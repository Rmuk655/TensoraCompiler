# GENERATED-FROM-SOURCE fixture file (see docs/testing/TEST_MATRIX.md for
# what each ID checks). Hand-edited, NOT tool-generated: this is real .tns
# source, kept syntax-highlightable, one case per '### ID | description'
# block. tools/gen_fixture_cases.py turns this into a generated .cpp with one
# TEST_CASE(...) per entry (see cmake/Tests.cmake). Each block runs until the
# next '### ' line or end of file.
#
# expect: ok               -- program is accepted, no further check
# expect: reject <DiagCode> -- program is rejected, and the FIRST reported
#                              diagnostic must have this DiagCode

### SEM-DECL-001 | duplicate global name is rejected
### expect: reject SemaRedeclaration
input x: Tensor[a=1]
weight x: Tensor[a=1]
graph g { return x }

### SEM-DECL-002 | duplicate graph name is rejected
### expect: reject SemaRedeclaration
input a: Tensor[x=1]
graph g { return a }
graph g { return a }

### SEM-DECL-003 | a graph-local assignment cannot shadow a global input/weight (different kind)
### expect: reject SemaRedeclaration
input x: Tensor[a=1]
graph g {
  x = relu(x)
  return x
}

### SEM-DECL-004 | a duplicate axis name within one tensor type is rejected (RM 3.3, ARCH-013)
### expect: reject SemaDuplicateAxisName
input x: Tensor[batch=4, batch=8]
graph g { return x }

### SEM-DECL-005 | a duplicate axis name in a reshape target is rejected (RM 3.3, ARCH-013)
### expect: reject SemaDuplicateAxisName
input x: Tensor[batch=4, feat=8]
graph g {
  y = reshape(x, [batch=4, batch=8])
  return y
}

### SEM-NAME-001 | use of an undefined name is rejected
### expect: reject SemaUndefinedName
graph g {
  y = relu(x)
  return y
}

### SEM-NAME-002 | return of an unbound name is rejected
### expect: reject SemaUndefinedName
input x: Tensor[a=1]
graph g {
  y = relu(x)
  return z
}

### SEM-NAME-003 | calling an operator name outside the frozen set is rejected
### expect: reject SemaUndefinedName
input x: Tensor[a=1]
graph g {
  y = sigmoid(x)
  return y
}

### SEM-SCOPE-002 | a value name from graph A is not visible in graph B
### expect: reject SemaUndefinedName
input x: Tensor[a=1]
graph a { h = relu(x)
 return h }
graph b { return h }

### SEM-TYPE-001 | matmul with a scalar operand (x @ 0.5) requires a tensor
### expect: reject SemaTypeMismatch
input x: Tensor[a=1,b=2]
graph g {
  y = x @ 0.5
  return y
}

### SEM-ARITY-001 | linear with 2 args instead of 3 is rejected
### expect: reject SemaArgCount
input x: Tensor[a=1,b=2]
weight w: Tensor[b=2,c=3]
graph g {
  y = linear(x, w)
  return y
}

### SEM-ARITY-002 | conv2d missing the stride keyword is rejected
### expect: reject SemaArgCount
input x: Tensor[batch=B,channel=3,height=4,width=4]
weight w: Tensor[out_channel=2,in_channel=3,kh=3,kw=3]
weight b: Tensor[out_channel=2]
graph g {
  y = conv2d(x, w, b, padding=1)
  return y
}

### SEM-ARITY-003 | softmax axis given as an integer instead of an identifier
### expect: reject SemaArgKind
input x: Tensor[a=1,b=2]
graph g {
  y = softmax(x, axis=1)
  return y
}

### SEM-ARITY-004 | relu with an unknown keyword argument is rejected
### expect: reject SemaArgKind
input x: Tensor[a=1]
graph g {
  y = relu(x, foo=1)
  return y
}

### SEM-ARITY-005 | transpose missing perm is rejected
### expect: reject SemaArgCount
input x: Tensor[a=1,b=2]
graph g {
  y = transpose(x)
  return y
}

### SEM-MM-002 | matmul: contraction dims 784 != 512 is rejected
### expect: reject SemaShapeMismatch
input x: Tensor[batch=B,feat=784]
weight w: Tensor[in=512,out=256]
graph g {
  y = x @ w
  return y
}

### SEM-MM-003 | matmul: symbolic contraction K unifies (near-miss of MM-002)
### expect: ok
input x: Tensor[batch=B,feat=K]
weight w: Tensor[in=K,out=256]
graph g {
  y = x @ w
  return y
}

### SEM-MM-004 | matmul: batched leading-axis mismatch is rejected
### expect: reject SemaBroadcast
