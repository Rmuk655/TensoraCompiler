graph g {
  y = reshape(x, [head=10,dim=64])
  return y
}

### SEM-RS-003 | reshape: unrelated symbolic factors cannot be statically resolved
### expect: reject SemaUnresolvableShape
input x: Tensor[batch=B,feat=768]
graph g {
  y = reshape(x, [batch=C,head=12,dim=64])
  return y
}

