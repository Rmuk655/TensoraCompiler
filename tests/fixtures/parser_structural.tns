 return x }
graph g3 { return a }

### PAR-008 | statement: sequential statements with no terminator, incl. bare-identifier rhs
graph g {
  a = b
  c = d
  return c
}

### PAR-009 | expression/binop: each of @ + - * / with identifier and float operand
graph g {
  a1 = x @ y
  a2 = x + y
  a3 = x - 0.5
  a4 = x * y
  a5 = x / 0.25
  return a5
}

### PAR-010 | callExpr: one positional arg, multiple positional args
graph g {
  a = relu(x)
  b = linear(x, w, bias)
  return b
}

### PAR-011 | arg kinds: keyword(int), keyword(identifier), axis-list, all mixed in one call
graph g {
  a = f(x, stride=1, axis=nm, [p=1, q=2])
  return a
}

### PAR-012 | argValue kinds: intLit (stride=1), identifier (axis=nm), intList (perm=[...])
graph g {
  a = f(x, stride=1)
  b = f(x, axis=nm)
  c = f(x, perm=[0, 1, 3, 2])
  return c
}

### PAR-013 | conv2d-shaped call: multiple positional + multiple keyword args together
graph g {
  a = conv2d(image, W, b, stride=1, padding=1)
  return a
}

